# SavvyBot Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/savvybot?sslmode=disable

# ============================================
# REDIS
# ============================================
# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# ============================================
# ENCRYPTION
# ============================================
# AES-256-GCM encryption key (32 bytes, base64 encoded)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# ============================================
# JWT SECRETS
# ============================================
# JWT secret for access tokens (32+ characters)
JWT_SECRET=

# JWT secret for refresh tokens (32+ characters)
JWT_REFRESH_SECRET=

# ============================================
# OAUTH PROVIDERS
# ============================================
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# STRIPE (Optional - Billing)
# ============================================
# Enable/disable billing (default: false)
BILLING_ENABLED=false

# Stripe API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# COMPOSIO (Optional - App Integrations)
# ============================================
# Composio API key (platform owner's key)
COMPOSIO_API_KEY=

# ============================================
# APPLICATION
# ============================================
# Public URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment (development, staging, production)
NODE_ENV=development

# Port for web application
PORT=3000
