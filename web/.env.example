# Database
DATABASE_URL=postgresql://user:password@localhost:5432/savvybot

# Redis
REDIS_URL=redis://localhost:6379/0

# Encryption Key (32 bytes base64)
ENCRYPTION_KEY=your_32_byte_base64_encryption_key_here

# JWT Secret (32+ characters)
JWT_SECRET=your_jwt_secret_key_here_minimum_32_chars

# JWT Refresh Secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Stripe (optional - disabled by default)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe billing enabled (set to "true" to enable)
BILLING_ENABLED=false

# Platform owner's Composio API key (encrypted in DB)
COMPOSIO_API_KEY=your_composio_api_key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth.js configuration (REQUIRED for authentication)
NEXTAUTH_SECRET=your_random_secure_string_here_minimum_32_chars
NEXTAUTH_URL=http://localhost:3000

# Environment
NODE_ENV=development

# Port
PORT=3000
